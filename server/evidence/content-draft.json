{
  "skills": [
    {
      "id": "signed-number-context",
      "title": "正负数与参照量",
      "observableTask": "根据明确的零点和正方向，用正数、负数或零表示数量。"
    },
    {
      "id": "number-line",
      "title": "数轴位置与单位长度",
      "observableTask": "在给定原点、正方向和单位长度的数轴上读数、定位并解释刻度。"
    },
    {
      "id": "opposite",
      "title": "相反数",
      "observableTask": "求正数、负数和零的相反数，并用对称位置或和为零解释。"
    },
    {
      "id": "absolute",
      "title": "绝对值与距离",
      "observableTask": "区分有向位置与到零的距离，计算绝对值，并由距离和方向反求数。"
    },
    {
      "id": "compare-negative",
      "title": "负数大小比较",
      "observableTask": "比较两个负数，并区分数的大小与绝对值的大小。"
    },
    {
      "id": "addition-same",
      "title": "同号有理数相加",
      "observableTask": "分别确定同号加法的结果符号和绝对值，并联系数轴移动。"
    },
    {
      "id": "addition-different",
      "title": "异号有理数相加",
      "observableTask": "通过抵消或数轴移动判断结果符号，计算绝对值之差，识别零对。"
    },
    {
      "id": "subtraction",
      "title": "减去一个有理数",
      "observableTask": "保留被减数，把减法改写为加上减数的相反数，再完成计算。"
    },
    {
      "id": "multiplication-division",
      "title": "有理数乘除",
      "observableTask": "区分结果符号和大小，识别除数不能为零，并使用逆运算检查。"
    },
    {
      "id": "power-base",
      "title": "乘方底数与负号范围",
      "observableTask": "区分带括号的负数底数和幂外负号，按指数展开并计算。"
    },
    {
      "id": "operation-order",
      "title": "混合运算顺序",
      "observableTask": "识别括号、乘方、乘除、加减的层次，逐步记录等值计算。"
    }
  ],
